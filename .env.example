# Business identity (all optional except secrets and root credentials)
APP_NAME=Blue Me
BUSINESS_NAME=Blue Me Demo
BRAND_TAGLINE=مدیریت شفاف، تصمیم‌گیری هوشمند
BRAND_PRIMARY_COLOR=#2563eb
BRAND_LOGO_URL=
APP_LOCALE=fa
APP_TIMEZONE=UTC
CURRENCY_LABEL=تومان

# Runtime
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480
API_HOST=0.0.0.0
API_PORT=8100
WEB_PORT=3100
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# MySQL. Set DATABASE_MODE=external for an existing server, or managed for bundled MySQL.
DATABASE_MODE=managed
COMPOSE_PROFILES=managed-db
DATABASE_HOST=localhost
CONTAINER_DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=blue_me
DATABASE_USER=blue_me
DATABASE_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Root account created during bootstrap (password is never stored in the DB as plaintext)
ROOT_USERNAME=root
ROOT_PASSWORD=replace-with-a-strong-root-password
ROOT_FULL_NAME=Root Administrator

# Browser-facing API path; /api is correct for the bundled reverse proxy
VITE_API_BASE_URL=/api
